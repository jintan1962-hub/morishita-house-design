# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma が生成するクライアント（ビルド生成物）。
# プラットフォーム依存のエンジンバイナリ（macOS用17MB / Linux用16MB）を含むため
# コミットしない。macOSで生成したものをVercel(Linux)へ持ち込むと実行時に落ちる。
# 各環境の postinstall（prisma generate）で作り直す。
/src/generated/

# --- 開発ルール O-08 で必須の除外 ---
*credential*
*serviceaccount*
*.p12
*.csv
*.xlsx
*.xls
.venv/
# ローカル開発用DBファイル（追跡しない）
prisma/dev.db
prisma/dev.db-journal
