generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Property {
  id               Int             @id @default(autoincrement())
  objMngNo         Int             @unique
  syubetu          Int
  syumoku          String
  title            String
  priceMan         Int
  madori           String
  landMen          Float?
  bldMen           Float?
  bldStructure     String?
  bldY             Int?
  bldM             Int?
  address          String
  prefCd           String
  cityCd           String
  elementarySchool String?
  juniorHighSchool String?
  currentState     String?
  disclosureLevel  Int             @default(0)
  priceDown        Boolean         @default(false)
  reformTarget     Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  images           PropertyImage[]
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  path       String
  property   Property @relation(fields: [propertyId], references: [id])
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String?
  password      String?
  tel           String?
  zip           String?
  address       String?
  role          String    @default("USER")
  status        String    @default("ACTIVE")
  memberType    String    @default("FREE")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
