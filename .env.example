# このファイルはキー名の一覧である。実際の値は .env に書き、.env は決してコミットしない

DATABASE_URL=       # Supabase の接続文字列（pgbouncer経由）
DIRECT_URL=         # Supabase の直接接続文字列（マイグレーション用）
NEXTAUTH_SECRET=    # セッション署名鍵。未設定だとアプリが起動しない。`openssl rand -base64 32` で生成
NEXTAUTH_URL=       # サイトのURL（例: https://example.com）
NEXT_PUBLIC_SITE_ORIGIN= # メール本文に載せるサイトURL（未設定なら NEXTAUTH_URL を使う）
MAIL_FROM_ADDRESS=  # 送信元メールアドレス
SMTP_HOST=          # SMTPサーバー名。未設定だとテスト送信になり実際には届かない
SMTP_PORT=          # SMTPポート（587 または 465）
SMTP_USER=          # SMTP認証ユーザー
SMTP_PASS=          # SMTP認証パスワード
MAIL_SENDING_DISABLED= # true にすると全メール送信を停止（O-05 停止スイッチの予備手段）
