# このファイルは「キー名の一覧」である。実際の値はここに書かない（S-01）。
#   ローカル開発 → .env.local に書く（.gitignore 対象）
#   本番         → Vercel のダッシュボードで設定する。AIには値を渡さない
#
# 本番環境の作り方は docs/本番環境の作り方.md を参照。

# ============================================================
# 必須（未設定だと動かない・危険）
# ============================================================
DATABASE_URL=       # Supabase の接続文字列（Connection pooling / ポート6543）
DIRECT_URL=         # Supabase の直接接続文字列（ポート5432。マイグレーション用）
NEXTAUTH_SECRET=    # セッション署名鍵。`openssl rand -base64 32` で生成。★本番とローカルで別の値にする
NEXTAUTH_URL=       # サイトのURL（例: https://example.com）
NEXT_PUBLIC_SITE_ORIGIN= # メール本文に載せるサイトURL（未設定なら NEXTAUTH_URL を使う）

# ============================================================
# 物件画像の保管（Supabase Storage）
# ============================================================
SUPABASE_URL=              # 例: https://xxxxxxxx.supabase.co（Project Settings → API の Project URL）
                           # ダッシュボードのURLでもDBのホスト名でもない。取り違えは起動時に検知される
SUPABASE_SERVICE_ROLE_KEY= # service_role キー。★サーバー専用。NEXT_PUBLIC_ を付けないこと
                           #（付けるとブラウザへ配信され、DBを全操作できる鍵が漏れる）
SUPABASE_STORAGE_BUCKET=   # バケット名（未設定なら property-images）

# ============================================================
# メール送信（Resend）
# ============================================================
RESEND_API_KEY=     # https://resend.com の API キー（re_ で始まる）
                    # 未設定でもアプリは動くが、送信は必ず失敗として MailLog に残る
MAIL_FROM_ADDRESS=  # 送信元アドレス。Resendで認証済みのドメインのアドレスにすること
                    #（ドメイン認証前の動作確認では onboarding@resend.dev を使う）
MAIL_ADMIN_ADDRESS= # 問い合わせ着信・新規入会の通知先。未設定なら管理者宛の通知は送らない
MAIL_SENDING_DISABLED= # true にすると全メール送信を停止（O-05 停止スイッチの予備手段）
                       # 正規の停止スイッチは DB の SystemSetting（MAIL_SENDING_ENABLED=false）

# ============================================================
# アクセス解析・広告タグ（任意。未設定ならタグは1本も出力されない）
# ============================================================
# ★ここに他社（大井建設工業／RENOEL）のIDを絶対に入れないこと。
#   複製元のコードには直書きされており、そのままだと他社の解析アカウントへ
#   モリシタハウスの訪問者データが送られる状態だった（2026-08-25 に撤去済み）。
NEXT_PUBLIC_GA4_ID=          # GA4 測定ID（G-XXXXXXXXXX）
NEXT_PUBLIC_GOOGLE_ADS_ID=   # Google広告 コンバージョンID（AW-XXXXXXXXX）
NEXT_PUBLIC_CLARITY_ID=      # Microsoft Clarity プロジェクトID
NEXT_PUBLIC_META_PIXEL_ID=   # Meta ピクセルID

# ============================================================
# 開発用（本番では設定しない）
# ============================================================
SEED_PASSWORD=      # pnpm seed:dev が作る開発アカウントのパスワード（未設定なら既定値）
